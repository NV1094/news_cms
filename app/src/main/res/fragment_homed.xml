<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.home.HomeFragmentC">

    <FrameLayout
        android:id="@+id/fragmentTop"
        android:layout_width="match_parent"
        android:layout_height="121dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_home_top_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:id="@+id/home_dw"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/home_logo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:paddingStart="2dp"
                    android:src="@drawable/default_avater"
                    tools:ignore="RtlSymmetry" />

                <LinearLayout
                    android:id="@+id/wqddg_line"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_skips"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="@dimen/dp_10">

                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_sousuo" />

                    <com.sunfusheng.marqueeview.MarqueeView
                        android:id="@+id/tv_home_seek"
                        android:layout_width="0dp"
                        android:layout_marginStart="@dimen/dp_10"
                        android:layout_height="30dp"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:drawablePadding="15dp"
                        android:ellipsize="marquee"
                        android:gravity="center_vertical|start"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:text="@string/seek"
                        android:textSize="@dimen/font_normal"
                        app:mvTextColor="#D780868B"
                        tools:ignore="NestedWeights,SpUsage" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_home_all"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_skip"
                    android:drawablePadding="1dp"
                    android:gravity="center"
                    android:paddingLeft="13dp"
                    android:paddingRight="13dp"
                    android:text=" 筛 选"
                    android:textColor="@color/aliceBlue"
                    android:textSize="@dimen/font_normal"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_home_history"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/ic_lishi"
                    android:contentDescription="@string/iv"/>

                <ImageView
                    android:id="@+id/iv_home_download"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/ic_xduanxin"
                    android:contentDescription="@string/iv"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_home_bar1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="-6dp"
                android:layout_marginRight="-6dp"
                android:orientation="horizontal">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tl_home"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="1dp"
                    app:tabMaxWidth="200dp"
                    app:tabMinWidth="20dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tabBackground="@color/transparent"
                    app:tabGravity="center"
                    app:tabIndicatorColor="#8ca4fa"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorHeight="3dp"
                    app:tabMode="scrollable"
                    app:tabPaddingEnd="10dp"
                    app:tabPaddingStart="10dp"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabSelectedTextColor="#8ca4fa"
                    app:tabTextAppearance="@style/MyTabLayoutTextAppearance"
                    app:tabTextColor="@color/textColor6" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lineColor"
                tools:ignore="MissingConstraints" />
        </LinearLayout>
    </FrameLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragmentTop" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/conPlayHis"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_skip2"
        android:padding="@dimen/dp_10"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/btnAppMore"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="right"
            android:orientation="horizontal"
            tools:ignore="MissingConstraints">

            <ImageView
                android:id="@+id/imgClosHis"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/icon_close22"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/tvHis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:textColor="#fff"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="上次观看：斗罗大陆 第一集" />

            <TextView
                android:id="@+id/tvHis1"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_10"
                android:background="@drawable/bg_red3"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="继续播放"
                android:textColor="#fff"
                android:textSize="10sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>