<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_margin="16dp"

    android:background="@drawable/glass_panel_strong_bg"
    android:clipToOutline="true"
    >

<LinearLayout
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    >

    <!-- 公告标题区：使用 bg_new_notice.png（红色渐变+波浪）作为顶部装饰背景，
         高度按图片比例（578x287 → 300dp宽约150dp高）避免拉伸 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_new_notice">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:text="公告"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <TextView
        android:id="@+id/tvNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:lineSpacingExtra="5dp"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:text="啊手动阀打发算法士大夫撒旦飞洒飞洒发生发射点啊士大夫首发式发生飞洒飞洒飞洒发的撒旦发射点发射点发"
        android:textColor="@color/glass_text_primary"
        android:textSize="14sp" />


    <TextView
        android:id="@+id/tv_close"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:layout_centerHorizontal="true"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/glass_pill_bg"
        android:gravity="center"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="我知道了"
        android:layout_marginBottom="20dp"
        android:textColor="@color/glass_text_primary"
        android:textSize="16sp" />

</LinearLayout>

</eightbitlab.com.blurview.BlurView>