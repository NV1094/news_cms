<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_wash"
    android:orientation="vertical"
    tools:context=".ui.pay.PayActivity">

    <View
        android:layout_width="match_parent"
        android:background="@android:color/transparent"
        android:layout_height="25dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/glass_bottom_bar_bg">

        <RelativeLayout
            android:id="@+id/rl_msg_center"
            android:layout_width="0dp"
            android:background="@android:color/transparent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <RelativeLayout
                android:id="@+id/rlBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="11.2dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_title_back2s" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="会员专区"
                android:textColor="@color/glass_text_primary"
                android:textSize="18dp"
                android:textStyle="bold" />

            <View
                android:id="@+id/view_msg_center"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@color/glass_accent"
                android:visibility="gone" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_system_notice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/system_notice"
                android:textColor="@color/glass_text_primary"
                android:textSize="16dp"
                android:textStyle="bold" />

            <View
                android:id="@+id/view_system_notice"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@color/glass_accent"
                android:visibility="gone" />
        </RelativeLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical">



        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tvAvator"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginLeft="22dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/default_avater" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/tvAvator"
                android:layout_marginTop="10dp"
                android:layout_toRightOf="@id/tvAvator"
                android:text="会员名"
                android:textColor="@color/glass_text_primary"
                android:textSize="@dimen/font_large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExpireTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/tvAvator"
                android:layout_marginBottom="6dp"
                android:layout_toRightOf="@id/tvAvator"
                android:text="升级会员，享超值服务"
                android:textColor="@color/glass_text_secondary"
                android:textSize="@dimen/font_small" />
            <TextView
                android:id="@+id/iv_task_back"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_alignParentRight="true"
                android:layout_alignTop="@id/tvAvator"
                android:layout_marginTop="10dp"
                android:layout_marginRight="0dp"
                android:text="返回"
                android:textColor="@color/glass_text_primary"
                android:gravity="center"
                android:textSize="@dimen/font_small" />


            <TextView
                android:id="@+id/tv_task_title"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/pay_title"/>

        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="6dp"
            android:background="@android:color/transparent"
            app:cardBackgroundColor="@color/glass_fill_start"
            app:cardCornerRadius="14dp"
            app:cardElevation="0.1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvAvator"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="65dp"
                android:layout_marginBottom="2dp"
                android:gravity="center"
                android:text="@string/remaining_points"
                android:textColor="@color/glass_text_primary"
                android:textSize="@dimen/font_larges" />

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_centerInParent="true"
                android:layout_gravity="center_vertical"
                android:background="@color/glass_text_tertiary" />

            <TextView
                android:id="@+id/tvCoin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="65dp"
                android:layout_marginBottom="2dp"
                android:gravity="center"
                android:text="@string/remaining_coin"
                android:textColor="@color/glass_text_primary"
                android:textSize="@dimen/font_larges" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="16dp"
            android:background="@android:color/transparent"
            app:cardBackgroundColor="@color/glass_fill_start"
            app:cardCornerRadius="14dp"
            app:cardElevation="0.1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/awvUsers"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/vipdefaultbanners" />
                    </FrameLayout>
                </LinearLayout>

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:textStyle="bold"
        app:tabGravity="fill"
        app:tabIndicatorHeight="2dp"
        app:tabIndicatorColor="@color/transparent"
        app:tabMode="fixed"
        app:tabPaddingEnd="5dp"
        app:tabPaddingStart="5dp"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="@color/glass_accent"
        app:tabTextAppearance="@style/MyTabLayoutTextAppearance3"
        app:tabTextColor="@color/glass_text_secondary"/>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vpPay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>