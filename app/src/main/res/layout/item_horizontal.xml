<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="180dp"
    android:paddingBottom="@dimen/dp_4"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_card_bg"
    android:foreground="?android:attr/selectableItemBackground"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_iv_card_child_icon"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/error"
            android:contentDescription="@string/iv"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="48.6dp"
            android:layout_height="19.8dp"
            android:gravity="center|left">

        </LinearLayout>

        <ImageView
            android:layout_width="39dp"
            android:layout_height="38dp"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/ic_video_hot_playsss" />

    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/item_tv_card_child_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="@dimen/dp_4"
        android:ellipsize="end"
        android:gravity="center|start"
        android:includeFontPadding="false"
        android:paddingTop="7dp"
        android:singleLine="true"
        android:textColor="@color/glass_text_primary"
        android:textSize="14dp"
        android:textStyle="bold"
        android:visibility="visible"
        app:autoSizeTextType="uniform"
        tools:text="风语咒" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/item_tv_card_child_vod_blurb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="@dimen/dp_4"
        android:ellipsize="end"
        android:gravity="center|start"
        android:singleLine="true"
        android:textColor="@color/glass_text_secondary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="风语咒" />

</LinearLayout>
