<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="86dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:paddingBottom="8dp"
    android:paddingLeft="2dp"
    android:paddingRight="2dp"
    android:background="@drawable/glass_card_bg"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="128dp"
        android:layout_height="86dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_iv_card_child_icon"
            android:layout_width="128dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/error"
            android:scaleType="fitXY"
            android:contentDescription="@string/iv" />

        <TextView
            android:id="@+id/item_tv_card_child_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:background="#00FFFFFF"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="@dimen/font_smaller"
            tools:text="@string/tip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right">

            <ImageView
                android:layout_marginEnd="2dp"
                android:layout_marginTop="1.2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_video_hot_play"/>

        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/item_tv_card_child_up_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:ellipsize="end"
            android:gravity="center|end"
            android:includeFontPadding="false"
            android:padding="5dp"
            android:singleLine="true"
            android:text="@string/up_title"
            android:textColor="@color/white"
            android:textSize="@dimen/font_smaller" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/item_tv_card_child_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="@dimen/dp_4"
            android:ellipsize="end"
            android:gravity="center|right"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/glass_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="visible"
            app:autoSizeTextType="uniform"
            tools:text="风语咒" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/item_tv_card_child_vod_blurb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center|start"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/glass_text_secondary"
            android:textSize="12sp"
            android:visibility="visible"
            app:autoSizeTextType="uniform"
            tools:text="风语咒" />
    </LinearLayout>

</LinearLayout>