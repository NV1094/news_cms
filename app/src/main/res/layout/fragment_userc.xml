<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_wash"
    android:orientation="vertical"
    tools:context=".ui.user.UserFragmentC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:background="@drawable/glass_panel_bg"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dp_40"
                    android:gravity="center|top"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_marginTop="@dimen/dp_10"
                        android:id="@+id/iv_user_plc"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/ic_mine_head_default"
                        android:contentDescription="@string/todo" />

                    <TextView
                        android:id="@+id/tvLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/login_or_register"
                        android:visibility="gone"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="@dimen/font_larges"
                        android:textStyle="bold"
                        tools:ignore="SpUsage" />

                    <TextView
                        android:id="@+id/tv_user_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="@dimen/font_larges"
                        tools:ignore="SpUsage"
                        tools:text="@string/app_name" />

                    <TextView
                        android:id="@+id/tv_user_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="@dimen/font_small"
                        tools:ignore="SpUsage"
                        tools:text="到期时间：2020-12-30" />
                </LinearLayout>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/mcv_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="-36dp"
                android:layout_marginRight="18dp"
                android:layout_marginBottom="5dp"
                app:cardCornerRadius="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal"
                                tools:ignore="UseCompoundDrawables">

                                <ImageView
                                    android:contentDescription="@string/todo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="海量视频免费看 "
                                    android:src="@drawable/ic_vipuser"
                                    android:textColor="@color/glass_text_secondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_height="wrap_content"
                                    android:text="会员中心"
                                    android:textColor="@color/textColor"
                                    android:textSize="@dimen/font_small"
                                    android:textStyle="bold"
                                    tools:ignore="NestedWeights,SpUsage" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="海量视频免费看 "
                                    android:textColor="@color/glass_text_secondary"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    tools:ignore="SmallSp" />

                                <TextView
                                    android:id="@+id/tv_user_t3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="  立即续费>"
                                    android:textColor="@color/glass_accent"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>

                        <View
                            android:layout_width="0.8dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@color/unBlack" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal"
                                tools:ignore="UseCompoundDrawables">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="海量视频免费看 "
                                    android:src="@drawable/ic_yuer"
                                    android:textColor="@color/glass_text_secondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_marginLeft="6dp"
                                    android:layout_height="wrap_content"
                                    android:text="我的钱包"
                                    android:textColor="@color/textColor"
                                    android:textSize="@dimen/font_small"
                                    android:textStyle="bold"
                                    tools:ignore="NestedWeights,SpUsage" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_user_jifen"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="当前积分 300"
                                    android:textColor="@color/glass_text_secondary"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    tools:ignore="SmallSp" />

                                <TextView
                                    android:id="@+id/tv_user_t2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="  立即充值>"
                                    android:textColor="@color/glass_accent"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>


                </RelativeLayout>


            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llExpand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:paddingTop="8dp"
                android:paddingRight="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/ic_gg" />

                <TextView
                    android:id="@+id/gonggao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:singleLine="true"
                    android:text="完成每日任务可获取积分奖励"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="@dimen/font_smaller"
                    tools:ignore="SpUsage" />

            </LinearLayout>

            <View
                android:layout_width="wrap_content"
                android:layout_height="1dp"
                android:visibility="gone"
                android:background="#E8EAED" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/awvUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_task"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginBottom="@dimen/dp_10">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:text="@string/task_title"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="@dimen/font_small"
                        android:textStyle="normal"
                        app:drawableTopCompat="@drawable/ic_renw"
                        tools:ignore="SpUsage" />

                    <TextView

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_weight="1"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:text="每日分享"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="@dimen/font_small"
                        android:textStyle="normal"
                        app:drawableTopCompat="@drawable/ic_fenxiang"
                        tools:ignore="SpUsage" />


                    <TextView
                        android:id="@+id/tv_user_servlce"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_weight="1"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:text="在线客服"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="@dimen/font_small"
                        android:textStyle="normal"
                        app:drawableTopCompat="@drawable/ic_kefu"
                        tools:ignore="SpUsage" />

                    <TextView
                        android:id="@+id/tv_coin_withdraw"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_weight="1"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:text="金币提现"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="@dimen/font_small"
                        android:textStyle="normal"
                        app:drawableTopCompat="@drawable/ic_jinbi"
                        tools:ignore="SpUsage" />

                    <TextView
                        android:id="@+id/shop_home"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_weight="1"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:text="积分商城"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="@dimen/font_small"
                        android:textStyle="normal"
                        tools:ignore="SpUsage"
                        app:drawableTopCompat="@drawable/ic_jifen" />
                </LinearLayout>

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/iv_PlayScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llPlayScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:layout_marginBottom="6dp"
                    android:paddingLeft="16dp"
                    android:paddingTop="12dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/play_score"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="@dimen/font_large"
                        android:textStyle="normal"
                        tools:ignore="SpUsage" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/ic_enter" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPlayScore"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:layout_marginBottom="5dp"
                    android:overScrollMode="never" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingLeft="18dp"
                android:paddingTop="8dp"
                android:layout_marginTop="20dp"
                android:paddingRight="18dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="常用功能"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="@dimen/font_large"
                    android:textStyle="normal"
                    tools:ignore="SpUsage" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/ll_task2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">

                        <TextView
                            android:id="@+id/tv_user_task"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="8dp"
                            android:gravity="center"
                            android:text="福利中心"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="@dimen/font_small"
                            android:textStyle="normal"
                            app:drawableTopCompat="@drawable/ic_gongwenbao" />

                        <TextView
                            android:id="@+id/tv_user_sign"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_weight="1"
                            android:drawablePadding="8dp"
                            android:gravity="center"
                            android:text="每日签到"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="@dimen/font_small"
                            android:textStyle="normal"
                            app:drawableTopCompat="@drawable/ic_daka" />

                        <TextView
                            android:id="@+id/llCollect"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_weight="1"
                            android:drawablePadding="8dp"
                            android:gravity="center"
                            android:text="我的收藏"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="@dimen/font_small"
                            android:textStyle="normal"
                            app:drawableTopCompat="@drawable/ic_shoucang" />

                        <TextView
                            android:id="@+id/liCache"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_weight="1"
                            android:drawablePadding="8dp"
                            android:gravity="center"
                            android:text="我的下载"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="@dimen/font_small"
                            android:textStyle="normal"
                            app:drawableTopCompat="@drawable/ic_yinhangka" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_task3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="100dp"
                        android:layout_marginBottom="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/llNotice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="8dp"
                                android:gravity="center"
                                android:text="系统消息"
                                android:textColor="@color/glass_text_primary"
                                android:textSize="@dimen/font_small"
                                android:textStyle="normal"
                                app:drawableTopCompat="@drawable/ic_xinxi"
                                tools:ignore="NestedWeights" />

                            <TextView
                                android:id="@+id/iv_llNotice"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginLeft="-16dp"
                                android:layout_marginTop="-20dp"
                                android:background="@drawable/shape_sign_bg"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/aliceBlue"
                                android:textSize="@dimen/font_small"
                                android:textStyle="normal"
                                tools:ignore="SpUsage" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_Message_Book"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_weight="1"
                            android:drawablePadding="8dp"
                            android:gravity="center"
                            android:text="留言求片"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="@dimen/font_small"
                            android:textStyle="normal"
                            app:drawableTopCompat="@drawable/ic_bianji" />

                        <TextView
                            android:id="@+id/tv_user_share"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_weight="1"
                            android:drawablePadding="8dp"
                            android:gravity="center"
                            android:text="分享有礼"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="@dimen/font_small"
                            android:textStyle="normal"
                            app:drawableTopCompat="@drawable/ic_hongbao" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_weight="1"
                            android:drawablePadding="8dp"
                            android:gravity="center"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="@dimen/font_small"
                            android:textStyle="normal" />
                    </LinearLayout>
                </RelativeLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</LinearLayout>