<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/glass_card_bg"
    android:orientation="vertical"
    android:layout_marginBottom="6dp"
    android:paddingLeft="20dp"
    android:paddingTop="12dp"
    android:paddingRight="20dp"
    android:paddingBottom="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="Suspicious0dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            tools:ignore="Suspicious0dp">
            <EditText
                android:id="@+id/etComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/glass_edittext_bg"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:maxEms="300"
                android:maxLines="5"
                android:hint="请输入评论内容"
                android:gravity="left"
                android:textColor="@color/glass_text_primary"
                android:textColorHint="@color/glass_text_tertiary"
                android:textSize="@dimen/font_small"
                android:minLines="5" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOk"
                android:background="@drawable/glass_pill_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="发 送"
                android:textColor="@color/glass_text_primary"
                android:textSize="@dimen/font_normal"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                tools:ignore="SpUsage" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"/>

            <TextView
                android:id="@+id/tvCancel"
                android:background="@drawable/glass_pill_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:text="@string/dialog_cancel"
                android:textColor="@color/glass_text_primary"
                android:textSize="@dimen/font_normal"
                tools:ignore="SpUsage" />
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:id="@+id/tvCount"
        android:text="0/300"
        android:textSize="@dimen/font_normal"
        android:layout_gravity="right"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:textColor="@color/glass_text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:ignore="SpUsage" />
</LinearLayout>
