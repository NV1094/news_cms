<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:padding="20dp"
    android:background="@drawable/glass_panel_strong_bg"

    android:layout_height="300dp">

    <TextView
        android:layout_width="wrap_content"
        android:text="无线投屏"
        android:textSize="16sp"
        android:textColor="@color/glass_text_primary"
        android:id="@+id/dlan_title"
        android:textStyle="bold"
        android:layout_height="wrap_content"/>

    <TextView
        android:layout_width="wrap_content"
        android:text="可用设备列表"
        android:textSize="12sp"
        android:textColor="@color/glass_text_secondary"
        android:id="@+id/dlan_small_tip"
        android:layout_below="@+id/dlan_title"
        android:layout_marginTop="4dp"
        android:layout_height="wrap_content"/>

    <ProgressBar
        android:id="@+id/loading"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="23dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/device_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/device_bottom_button"
        android:layout_below="@+id/dlan_small_tip"
        android:layout_marginTop="20dp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:id="@+id/device_bottom_button"
        android:layout_alignParentBottom="true"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="查看帮助"
            android:gravity="center"
            android:id="@+id/dlan_to_help"
            android:visibility="gone"
            android:background="@drawable/glass_pill_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginRight="8dp"
            android:textColor="@color/glass_text_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="取消"
            android:id="@+id/dlan_to_cancel"
            android:background="@drawable/glass_pill_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/glass_text_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</RelativeLayout>
