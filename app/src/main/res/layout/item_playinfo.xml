<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/glass_panel_bg"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    tools:ignore="SpUsage">

    <!--    android:background="@drawable/bof"-->
    <LinearLayout
        android:id="@+id/iv_go_vip"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/glass_card_bg"
        android:gravity="center"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:gravity="center|left"
            android:orientation="vertical">

            <TextView
                android:id="@+id/isvip_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:text="大会员6.3折！免费看海量精选视频..."
                android:textColor="@color/glass_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/isvip_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:drawablePadding="3dp"
                android:gravity="center"
                android:lines="1"
                android:text="海量精选会员内容免费看 · 抢先看 · 高清视频随心挑..."
                android:textColor="@color/glass_text_secondary"
                android:textSize="11sp"
                app:drawableLeftCompat="@drawable/ic_shijian" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:gravity="center"
            android:orientation="vertical"
            tools:ignore="RtlHardcoded">

            <LinearLayout
                android:id="@+id/iv_go_vipm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_pill_bg"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="成为大会员"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginTop="-36dp"
                android:background="@drawable/glass_pill_bg"
                android:paddingLeft="10dp"
                android:paddingTop="1dp"
                android:paddingRight="10dp"
                android:paddingBottom="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="低至0.1元/天"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/iv_play_bg"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="1dp"
        android:gravity="bottom"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            tools:ignore="RtlHardcoded,UselessParent">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tlPlaySource"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:textColor="@color/glass_text_secondary"
                app:tabGravity="fill"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="0dp"
                app:tabMinWidth="4dp"
                app:tabMode="scrollable"
                app:tabPaddingEnd="10dp"
                app:tabPaddingStart="1dp"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/glass_accent"
                app:tabTextAppearance="@style/MyTabLayoutTextAppearance3"
                app:tabTextColor="@color/glass_text_secondary"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

            <LinearLayout
                android:id="@+id/tv_av_danmaku2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/pop_danmu"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/glass_pill_bg"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingEnd="5dp"
                        android:text="@string/av_danmaku"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="13sp"
                        tools:ignore="RtlSymmetry" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/glass_pill_bg"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/todo"
                            android:src="@drawable/cheese_ic_danmaku_opened" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="@color/glass_stroke" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:baselineAligned="false"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10">

        <LinearLayout
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1.0"
            android:gravity="center_vertical"
            android:orientation="vertical"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/item_tv_playinfo_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lines="1"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="@dimen/font_large"
                    android:textStyle="bold"
                    tools:ignore="SpUsage"
                    tools:text="斛珠夫人" />

                <LinearLayout
                    android:id="@+id/item_tv_playinfo_collect3"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="@dimen/dp_10"
                    android:background="@drawable/glass_pill_bg"
                    android:gravity="center"
                    android:paddingLeft="12dp"
                    android:paddingTop="2dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/item_tv_playinfo_collect2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="2dp"
                        android:gravity="center"
                        android:paddingEnd="5dp"
                        android:text="@string/livei"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:drawableLeftCompat="@drawable/ic_livei"
                        tools:ignore="RtlSymmetry" />
                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_pill_bg"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-1dp"
                        android:drawablePadding="5dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/vod_type"
                        android:textColor="@color/tag_color_red2"
                        android:textSize="11dp"
                        app:drawableLeftCompat="@drawable/ic_home_cd"
                        tools:ignore="RtlSymmetry,SpUsage" />

                </LinearLayout>

                <View
                    android:layout_width="0.8dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginRight="6dp"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:background="@color/glass_text_tertiary" />

                <TextView
                    android:id="@+id/tvLastest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="@dimen/font_small"
                    tools:ignore="RtlSymmetry,SpUsage" />

                <TextView
                    android:id="@+id/item_svv_playinfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:text=""
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="@dimen/font_small"
                    android:textStyle="normal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="left|center"
                android:orientation="horizontal"
                tools:ignore="RtlHardcoded">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/item_tv_playinfo_hits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="@dimen/font_small"
                    tools:ignore="SpUsage"
                    tools:text="699次播放" />

                <TextView
                    android:id="@+id/vod_pubdates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:text="@string/select_play_resource1"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="@dimen/font_small" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/item_tv_playinfo_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/glass_accent"
                    android:textSize="@dimen/font_small"
                    tools:ignore="SpUsage"
                    tools:text="5.9分" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/item_tv_playinfo_intro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="5dp"
                    android:foreground="?selectableItemBackground"
                    android:includeFontPadding="false"
                    android:text="详情"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="@dimen/font_small"
                    android:textStyle="normal" />

                <ImageView
                    android:id="@+id/iv_lastest"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/ic_enter" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <cn.lvdou.vod.ad.AdWebView
        android:id="@+id/awvPlayerDown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_10"
        android:layout_marginTop="18dp"
        android:visibility="gone"
        android:layout_marginRight="@dimen/dp_10" />

    <FrameLayout
        android:id="@+id/item_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_10"
        android:layout_marginTop="18dp"
        android:layout_marginRight="@dimen/dp_10"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ll_play_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/item_tv_playinfo_comment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="left|center_vertical"
            android:layout_weight="1"
            android:background="@drawable/glass_pill_bg"
            android:drawableTop="@drawable/ic_livei4"
            android:drawablePadding="7dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLength="7"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="599评论"
            android:textColor="@color/glass_text_primary"
            android:textSize="@dimen/font_smallest" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/item_tv_playinfo_collect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_pill_bg"
            android:drawableTop="@drawable/ic_livei2"
            android:drawablePadding="7dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/collect"
            android:textColor="@color/glass_text_primary"
            android:textSize="@dimen/font_smallest" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/item_tv_playinfo_download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_pill_bg"
            android:drawableTop="@drawable/ic_livei6"
            android:drawablePadding="7dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/download"
            android:textColor="@color/glass_text_primary"
            android:textSize="@dimen/font_smallest" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/item_tv_playinfo_feedback"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_pill_bg"
            android:drawableTop="@drawable/ic_livei3"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/feedback"
            android:textColor="@color/glass_text_primary"
            android:textSize="@dimen/font_smallest" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/item_tv_playinfo_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_pill_bg"
            android:drawableTop="@drawable/ic_livei1"
            android:drawablePadding="7dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/share"
            android:textColor="@color/glass_text_primary"
            android:textSize="@dimen/font_smallest" />

    </LinearLayout>

    <!-- 播放源和选集-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="vertical"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLastest2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_play_resource"
                android:textColor="@color/glass_text_primary"
                android:textSize="@dimen/font_larges"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/checkOrder"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:background="@drawable/selector_order"
                android:button="@null"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right">

                <TextView
                    android:id="@+id/tvLastests"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="@dimen/font_small"
                    tools:ignore="RtlSymmetry,SpUsage" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/ic_enter" />
            </LinearLayout>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLastest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:scrollbars="none"
            tools:itemCount="8"
            tools:layoutManager="LinearLayoutManager"
            tools:listitem="@layout/item_video_source"
            tools:orientation="horizontal" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="2dp"
        android:background="@color/glass_stroke" />

    <FrameLayout
        android:id="@+id/ad_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</LinearLayout>
