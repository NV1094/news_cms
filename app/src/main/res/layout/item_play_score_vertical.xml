<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_card_bg"
    android:paddingLeft="10dp"
    android:layout_marginBottom="6dp"
    android:paddingTop="10dp"
    android:paddingRight="10dp"
    android:paddingBottom="10dp">

    <CheckBox
        android:id="@+id/cb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_centerVertical="true"
        android:clickable="false"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivImg"
        android:layout_width="100dp"
        android:layout_height="130dp"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@id/cb"
        android:background="@drawable/error"
        android:scaleType="centerCrop"
        tools:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/ivImg"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:layout_toEndOf="@id/ivImg"
        android:textColor="@color/glass_text_primary"
        android:textSize="@dimen/font_larges"
        android:textStyle="bold"
        tools:ignore="SpUsage"
        tools:text="钢铁侠 外文版" />

    <TextView
        android:id="@+id/tvPlayProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/tv_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="38dp"
        android:layout_toRightOf="@id/ivImg"
        android:drawableLeft="@drawable/ic_play_score"
        android:drawablePadding="8dp"
        android:ellipsize="end"
        android:maxEms="9"
        android:maxLines="1"
        android:text="观看至2%"
        android:textColor="@color/glass_text_secondary"
        android:textSize="@dimen/font_smaller"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/ivImg"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="5dp"
        android:layout_toEndOf="@id/ivImg"
        android:background="@drawable/glass_pill_bg"
        android:ellipsize="end"
        android:lineSpacingExtra="5dp"
        android:maxLines="3"
        android:paddingLeft="16dp"
        android:paddingTop="6dp"
        android:paddingRight="16dp"
        android:paddingBottom="6dp"
        android:singleLine="false"
        android:text="继续观看"
        android:textColor="@color/tag_color_red2"
        android:textSize="14sp" />



</RelativeLayout>
