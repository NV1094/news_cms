<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"

    android:background="@drawable/glass_panel_strong_bg"
    android:clipToOutline="true">

<LinearLayout
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingLeft="20dp"
    android:paddingTop="10dp"
    android:paddingRight="20dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/dialog_hit"
        android:textColor="@color/glass_text_primary"
        android:textSize="@dimen/font_large" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="25dp"
        android:visibility="gone"
        android:textColor="@color/glass_text_secondary"
        android:textSize="@dimen/font_normal" />
    <LinearLayout
        android:id="@+id/setedit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="8dp"
            android:layout_height="40dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="片头："
                android:textColor="@color/glass_text_primary"
                android:textSize="16dp" />

            <EditText
                android:id="@+id/editSec"
                android:layout_width="175dp"
                android:layout_height="57dp"
                android:background="@drawable/glass_edittext_bg"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_centerInParent="true"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:inputType="time"
                android:text="00:00:00"
                android:textColor="@color/glass_text_secondary"
                android:textSize="@dimen/font_normal" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="秒"
                android:visibility="gone"
                android:textColor="@color/glass_text_primary"
                android:textSize="16dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp"
            android:layout_height="40dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="片尾："
                android:textColor="@color/glass_text_primary"
                android:textSize="16dp" />
            <EditText
                android:id="@+id/editSec2"
                android:layout_width="175dp"
                android:layout_height="40dp"
                android:background="@drawable/glass_edittext_bg"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_centerInParent="true"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:text="00:00:00"
                android:inputType="time"
                android:textColor="@color/glass_text_secondary"
                android:textSize="@dimen/font_normal" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="秒"
                android:visibility="gone"
                android:textColor="@color/glass_text_primary"
                android:textSize="16dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvCancel"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_pill_bg"
            android:gravity="center"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="@dimen/font_small"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/dialog_cancel"
            android:textColor="@color/glass_text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvOk"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_pill_bg"
            android:gravity="center"
            android:foreground="?attr/selectableItemBackground"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/dialog_ok"
            android:textSize="@dimen/font_small"
            android:textColor="@color/glass_accent" />
    </LinearLayout>


</LinearLayout>

</eightbitlab.com.blurview.BlurView>