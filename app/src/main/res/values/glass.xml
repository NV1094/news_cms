<?xml version="1.0" encoding="utf-8"?>
<!-- 扁平（Flat）设计系统：纯色表面 + 细描边 + 谷歌配色 -->
<!-- 原"液体玻璃 Liquid Glass v2"的渐变/亮边/光泽/光晕 token 已全部扁平化 -->
<resources>

    <!-- ========== 表面填充（不透明纯色） ========== -->
    <color name="glass_fill_start">#FFFFFF</color>        <!-- 卡片/面板表面 -->
    <color name="glass_fill_end">#F1F3F4</color>          <!-- 胶囊/输入框/次级容器 -->
    <color name="glass_fill_strong_start">#FFFFFF</color> <!-- 对话框表面（保可读性） -->
    <color name="glass_fill_strong_end">#FFFFFF</color>

    <!-- ========== 描边（兼容旧引用：亮边 → 细分割线） ========== -->
    <color name="glass_edge_start">#E8EAED</color>
    <color name="glass_edge_end">#E8EAED</color>
    <color name="glass_stroke">#E8EAED</color>
    <color name="glass_stroke_strong">#E8EAED</color>
    <color name="glass_highlight">#00FFFFFF</color>       <!-- 透明：光泽带已移除 -->

    <!-- ========== 深色场景（播放器/沉浸，扁平深色） ========== -->
    <color name="glass_dark_fill_start">#202124</color>
    <color name="glass_dark_fill_end">#202124</color>
    <color name="glass_dark_edge_start">#3C4043</color>
    <color name="glass_dark_edge_end">#3C4043</color>

    <!-- ========== 表面文字（谷歌灰阶） ========== -->
    <color name="glass_text_primary">#202124</color>
    <color name="glass_text_secondary">#5F6368</color>
    <color name="glass_text_tertiary">#80868B</color>

    <!-- ========== 主色（Google 蓝） ========== -->
    <color name="glass_accent">#4285F4</color>
    <color name="glass_accent_soft">#E8F0FE</color>       <!-- 聚焦/选中浅蓝底 -->

    <!-- ========== 窗口底色（扁平 Google gray 50，彩色光晕已移除） ========== -->
    <color name="wash_start">#F8F9FA</color>
    <color name="wash_center">#F8F9FA</color>
    <color name="wash_end">#F8F9FA</color>
    <color name="wash_blob_blue">#00000000</color>
    <color name="wash_blob_green">#00000000</color>
    <color name="wash_blob_red">#00000000</color>

    <!-- ========== 圆角规范 ========== -->
    <dimen name="glass_radius_panel">20dp</dimen>
    <dimen name="glass_radius_card">18dp</dimen>
    <dimen name="glass_radius_pill">100dp</dimen>
    <dimen name="glass_radius_bar">24dp</dimen>
    <dimen name="glass_radius_input">16dp</dimen>
    <dimen name="glass_stroke_width">1dp</dimen>
    <dimen name="glass_edge_width">1.5dp</dimen>

    <!-- ========== 玻璃文字样式（保留） ========== -->
    <style name="GlassTextPrimary">
        <item name="android:textColor">@color/glass_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="GlassTextSecondary">
        <item name="android:textColor">@color/glass_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="GlassTextButton">
        <item name="android:textColor">@color/glass_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
